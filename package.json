{
  "name": "next-finance-site",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "clean:next": "powershell -ExecutionPolicy Bypass -File ./scripts/clean-next-cache.ps1",
    "dev": "node ./node_modules/next/dist/bin/next dev",
    "dev:3001": "node ./node_modules/next/dist/bin/next dev -p 3001",
    "build": "node ./node_modules/next/dist/bin/next build",
    "build:clean": "npm run clean:next && npm run build",
    "dev:clean": "npm run clean:next && npm run dev",
    "dev:3001:clean": "npm run clean:next && npm run dev:3001",
    "safe-build": "powershell -ExecutionPolicy Bypass -File ./scripts/safe-build.ps1",
    "start": "node ./node_modules/next/dist/bin/next start",
    "lint": "node ./node_modules/next/dist/bin/next lint"
  },
  "dependencies": {
    "framer-motion": "^12.38.0",
    "gsap": "^3.12.7",
    "lenis": "^1.1.20",
    "lucide-react": "^1.14.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.173.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2"
  }
}
